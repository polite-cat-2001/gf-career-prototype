{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "figma-developer-mcp", "--stdio", "--no-telemetry"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
